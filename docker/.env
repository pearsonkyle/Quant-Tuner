#!/bin/bash
#########################################################################
# Minimal red-team eval container — shared definitions.

PROJECT_NAME="quant-tuner-redteam"

# Base image: slim Python (CPU-only, API client). Override to pin a digest.
BUILD_IMAGE=python:3.12-slim

# Tag for the built image.
IMAGE_NAME=${MY_USERNAME:-$(whoami)}-quant-tuner-redteam

#########################################################################
# GAIAA API SETTING
#
# Set GAIAA_API_KEY in your shell before running. run.sh maps it to
# OPENAI_API_KEY inside the container and wires the host CA bundle so HTTPS to
# the GAIAA endpoint validates. Point the eval at GAIAA with, e.g.:
#   --judge-base-url https://api.ai.gd-ms.us/v1 --judge-model claude-4-6-sonnet
OPENAI_BASE_URL=https://api.ai.gd-ms.us/v1
# OPENAI_MODEL=claude-4-6-sonnet

#########################################################################
# Telemetry off (also set in the Dockerfile; here for the --env-file too).
DEEPEVAL_TELEMETRY_OPT_OUT=YES
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=False
